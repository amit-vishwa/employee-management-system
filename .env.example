# Copy this file to .env and replace every CHANGE_ME value.
# Never commit the completed .env file.

# JWT signing secret shared by auth-service and employee-service.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Employee database
EMS_DB_ROOT_PASSWORD=CHANGE_ME
EMS_DB_USERNAME=ems_app
EMS_DB_PASSWORD=CHANGE_ME

# Authentication database
AUTH_DB_ROOT_PASSWORD=CHANGE_ME
AUTH_DB_USERNAME=auth_app
AUTH_DB_PASSWORD=CHANGE_ME